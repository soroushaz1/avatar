# Copy to .env for local development. In production deploy/install.sh writes this file.
PORT=3000
HOST=127.0.0.1
BASE_URL=http://localhost:3000
DATA_DIR=data

# ZarinPal merchant id (36 characters). ZARINPAL_SANDBOX=true uses the sandbox gateway.
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false

# Google Gemini key for generating the 3D character from the user's photo.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Character generations per 24h: whole site / free visitor / subscriber.
AVATAR_DAILY_LIMIT=100
AVATAR_FREE_LIMIT=2
AVATAR_SUBSCRIBER_LIMIT=20

# Piper text-to-speech service (tts/server.py).
TTS_URL=http://127.0.0.1:5002
TTS_MAX_CHARS=1000

# Subscription prices in Toman.
PLAN_MONTHLY_TOMAN=99000
PLAN_QUARTERLY_TOMAN=249000
